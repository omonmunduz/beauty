{
  "name": "beauty-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm tenants:build && vite",
    "build": "pnpm tenants:build && tsc -b && vite build && tsx scripts/postbuild.ts",
    "preview": "pnpm run build && wrangler dev",
    "typecheck": "tsc -b",
    "lint": "oxlint src shared scripts supabase/functions",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "tenants:build": "tsx scripts/tenants-build.ts",
    "tenant:new": "tsx scripts/tenant-new.ts",
    "tenant:check": "tsx scripts/tenant-check.ts",
    "tenant:publish": "tsx scripts/tenant-publish.ts",
    "tenant:verify": "tsx scripts/tenant-verify.ts",
    "owner:create": "tsx scripts/owner-create.ts",
    "seed:build": "tsx scripts/seed-build.ts",
    "vapid:keys": "tsx scripts/vapid-keys.ts",
    "db:reset": "pnpm seed:build && supabase db reset",
    "setup:local": "tsx scripts/setup-local.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "prod:publish": "cross-env BEAUTY_ENV=production tsx scripts/tenant-publish.ts",
    "prod:owner": "cross-env BEAUTY_ENV=production tsx scripts/owner-create.ts",
    "prod:verify": "cross-env BEAUTY_ENV=production tsx scripts/tenant-verify.ts",
    "build:prod": "vite build --mode production",
    "deploy:vercel": "pnpm build && node -e \"require('fs').cpSync('.vercel','dist/.vercel',{recursive:true})\" && vercel deploy --prod --yes --cwd dist",
    "tenant:status": "tsx scripts/tenant-lifecycle.ts status",
    "prod:status": "cross-env BEAUTY_ENV=production tsx scripts/tenant-lifecycle.ts status",
    "tenant:archive": "tsx scripts/tenant-lifecycle.ts archive",
    "prod:archive": "cross-env BEAUTY_ENV=production tsx scripts/tenant-lifecycle.ts archive",
    "tenant:restore": "tsx scripts/tenant-lifecycle.ts restore",
    "prod:restore": "cross-env BEAUTY_ENV=production tsx scripts/tenant-lifecycle.ts restore",
    "tenant:extend": "tsx scripts/tenant-lifecycle.ts extend",
    "prod:extend": "cross-env BEAUTY_ENV=production tsx scripts/tenant-lifecycle.ts extend",
    "tenant:delete": "tsx scripts/tenant-lifecycle.ts delete",
    "prod:delete": "cross-env BEAUTY_ENV=production tsx scripts/tenant-lifecycle.ts delete",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy dist --project-name beauty-booking --branch main --commit-dirty=true",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.8",
    "@astryxdesign/theme-neutral": "^0.6.8",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.8",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.149.0"
  }
}
